# Admin dashboard (admin.premiumchecks.co.uk). Server side only: nothing here reaches the browser.

# Backend API base, including /api/v1.
API_URL=http://localhost:8000/api/v1

# Must equal the backend's TRUSTED_PROXY_SECRET, so the backend trusts the visitor IP we forward.
BACKEND_PROXY_SECRET=change-me

# Public origin of this dashboard (CSRF Origin check and absolute redirects).
DASHBOARD_URL=http://localhost:3001

# Public website address (not secret): preview links and the page editor's preview frame.
NEXT_PUBLIC_WEBSITE_URL=http://localhost:3000
